<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Documents.Skia</PackageId>
    <IsPackable>true</IsPackable>
    <Description>SkiaSharp PDF writer for PagedDocument: layout measurement, tables, images, header/footer, watermark; embedded Liberation Serif subset.</Description>
    <RootNamespace>Novolis.Documents.Skia</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Novolis.Math.Measure" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="Svg.Skia" />
    <ProjectReference Include="..\Novolis.Documents.Layout\Novolis.Documents.Layout.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fonts\LiberationSerif-Regular.ttf" LogicalName="Novolis.Documents.Skia.Fonts.LiberationSerif-Regular.ttf" />
    <EmbeddedResource Include="Fonts\LiberationSerif-Bold.ttf" LogicalName="Novolis.Documents.Skia.Fonts.LiberationSerif-Bold.ttf" />
    <None Include="Fonts\LICENSE-Liberation.txt" Pack="true" PackagePath="LICENSE-Liberation.txt" />
  </ItemGroup>
</Project>
